{
  "name": "barbz-zip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "BARBZ_ZIP_PREVIEW=local astro dev --host 127.0.0.1",
    "dev:mobile": "BARBZ_ZIP_PREVIEW=mobile astro dev --host 0.0.0.0 --port 4322",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "studio": "pnpm --dir sanity dev",
    "studio:build": "pnpm --dir sanity build",
    "studio:check": "pnpm --dir sanity check",
    "studio:deploy": "pnpm --dir sanity deploy"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^6.0.0",
    "groq": "^6.20.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
