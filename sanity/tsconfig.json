{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "allowJs": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
