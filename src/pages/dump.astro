---
import Layout from '../layouts/Layout.astro';
import DumpDescription from '../components/DumpDescription.astro';
import { getDumpImages } from '../data/dump';
import PortfolioImage from '../components/PortfolioImage.astro';
import { sitePath } from '../lib/paths';
import { Image } from 'astro:assets';
import carton from '../../public/images/dump/carton.png';
import trifold from '../../public/images/dump/trifold.png';
import photograph from '../../public/images/dump/photograph.png';
import truck from '../../public/images/dump/truck.png';
const sources = { carton, trifold, photograph, truck };
const previewImages = await getDumpImages();
---
<Layout page="dump" title="barbz.dump.zip">
  <main id="main" class="dump-page" data-dump>
    <div class="dump-viewport-metric" aria-hidden="true"></div>
    <h1 class="sr-only">barbz.zip — dump</h1>
    <div class="dump-wordmark" data-pixel-wordmark aria-hidden="true">
      <img src={sitePath('/images/dump/wordmark.svg')} alt="" draggable="false" />
      <svg class="dump-pixels" viewBox="0 0 1454.16 384.34" xmlns="http://www.w3.org/2000/svg"></svg>
    </div>
    <div class="dump-feed" id="dump-feed">
      {previewImages.map((item, index) => (
        <figure class={`dump-item dump-item--${item.id}`} style={`--image-width: ${item.width}px; --image-ratio: ${item.width} / ${item.height}; view-timeline-name: --dump-image-${index}; --image-timeline: --dump-image-${index}`} data-dump-item>
          <div class="dump-image" data-dump-image>
            {item.src.startsWith('https://') ? <PortfolioImage src={item.src} alt={item.alt} widths={[400, 800, 1200, 1600]} sizes={`(max-width: 800px) 100vw, ${Math.ceil(item.width * 1.12)}px`} loading={index < 2 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} draggable={false} /> : <Image src={sources[item.id as keyof typeof sources]} alt={item.alt}
              widths={[400, 800, 1200, 1600].filter(width => width <= sources[item.id as keyof typeof sources].width)}
              sizes={`(max-width: 800px) ${item.id === 'carton' ? '112vw' : '100vw'}, ${Math.ceil(item.width * 1.12 * (item.id === 'carton' ? 1.71 : 1.05))}px`}
              format="webp" quality={85} loading={index < 2 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" draggable="false" />}
          </div>
          <button class="dump-grid-open" type="button" data-dump-open={index} aria-label={`View image: ${item.title}`} aria-haspopup="dialog"></button>
        </figure>
      ))}
    </div>
    <DumpDescription images={previewImages} />
    <dialog class="dump-lightbox" data-dump-lightbox aria-label="Image preview">
      <figure class="dump-lightbox-media" data-dump-lightbox-media></figure>
      <button class="pill-button dump-lightbox-close" data-dump-lightbox-close type="button" aria-label="Close image preview">close ×</button>
      <DumpDescription images={previewImages} id="dump-lightbox-description" />
    </dialog>
  </main>
  <button class="pill-button dump-grid" type="button" data-dump-grid aria-controls="dump-feed" aria-pressed="false">Grid View</button>
  <span class="case-cursor dump-cursor" data-dump-cursor aria-hidden="true">scroll</span>
</Layout>
