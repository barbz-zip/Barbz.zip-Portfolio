---
import { sitePath, localPath } from '../lib/paths';
import PortfolioImage from './PortfolioImage.astro';
import type {HomeContent} from '../data/home';
interface Props {home: HomeContent}
const {home} = Astro.props;
const isIndex = localPath(Astro.url.pathname).replace(/\/$/, '') === '/index';
const isAbout = localPath(Astro.url.pathname).replace(/\/$/, '') === '/about';
const isHome = localPath(Astro.url.pathname) === '/';
const isDump = localPath(Astro.url.pathname).replace(/\/$/, '') === '/dump';
---
<header class="site-header" transition:persist="barbz-zip-header" transition:name="barbz-zip-header" transition:animate="none">
  <a draggable="false" href={sitePath(isDump ? '/' : '/dump/')} class="zip-mark" aria-label={isDump ? 'barbz.zip — home' : 'barbz.zip — dump'}>
    <img draggable="false" class="zip-mark-light" src={sitePath('/images/zip.png')} width="34" height="34" alt="" />
    <span class="zip-mark-dark"><PortfolioImage src="/images/dump/zip.png" alt="" widths={[80, 160, 240]} sizes="64px" /></span>
    <span class="zip-label" aria-hidden="true">dump</span>
  </a>
  <nav class="menu" aria-label="Main navigation">
    <span class="menu-indicator" aria-hidden="true"></span>
    <a draggable="false" class="menu-item" href={sitePath('/')} aria-current={isHome ? 'page' : undefined}>barbz.zip</a>
    <a draggable="false" class="menu-item" href={sitePath('/index/')} aria-current={isIndex ? 'page' : undefined}>index</a>
    <a draggable="false" class="menu-item" href={sitePath('/about/')} aria-current={isAbout ? 'page' : undefined}>about</a>
    {home.readUrl ? <a draggable="false" class="menu-item" href={home.readUrl} target="_blank" rel="noopener noreferrer">read</a> : <button class="menu-item" type="button" aria-disabled="true" title="Coming soon">read</button>}
    <button class="contact-button" type="button" data-copy-email={home.email} aria-label={home.email ? 'Copy email address' : 'Contact — coming soon'} aria-disabled={home.email ? undefined : 'true'}><img draggable="false" class="contact-icon-light" src={sitePath('/images/message.svg')} width="24" height="24" alt="" /><img draggable="false" class="contact-icon-dark" src={sitePath('/images/dump/message.svg')} width="24" height="24" alt="" /></button>
  </nav>
  <button class="contact-button contact-button--mobile" type="button" data-copy-email={home.email} aria-label={home.email ? 'Copy email address' : 'Contact — coming soon'} aria-disabled={home.email ? undefined : 'true'}><img draggable="false" src={sitePath('/images/message-mobile.svg')} width="30" height="30" alt="" /></button>
</header>
