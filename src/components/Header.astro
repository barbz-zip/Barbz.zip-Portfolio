---
import { sitePath, localPath } from '../lib/paths';
import PortfolioImage from './PortfolioImage.astro';
const items = ['read'];
const isIndex = localPath(Astro.url.pathname).replace(/\/$/, '') === '/index';
const isAbout = localPath(Astro.url.pathname).replace(/\/$/, '') === '/about';
const isHome = localPath(Astro.url.pathname) === '/';
const isDump = localPath(Astro.url.pathname).replace(/\/$/, '') === '/dump';
---
<header class="site-header" transition:persist="barbz-zip-header" transition:name="barbz-zip-header" transition:animate="none">
  <a href={sitePath(isDump ? '/' : '/dump/')} class="zip-mark" aria-label={isDump ? 'barbz.zip — home' : 'barbz.zip — dump'}>
    <img class="zip-mark-light" src={sitePath('/images/zip.png')} width="34" height="34" alt="" />
    <span class="zip-mark-dark"><PortfolioImage src="/images/dump/zip.png" alt="" widths={[80, 160, 240]} sizes="64px" /></span>
    <span class="zip-label" aria-hidden="true">dump</span>
  </a>
  <nav class="menu" aria-label="Main navigation">
    <span class="menu-indicator" aria-hidden="true"></span>
    <a class="menu-item" href={sitePath('/')} aria-current={isHome ? 'page' : undefined}>barbz.zip</a>
    <a class="menu-item" href={sitePath('/index/')} aria-current={isIndex ? 'page' : undefined}>index</a>
    <a class="menu-item" href={sitePath('/about/')} aria-current={isAbout ? 'page' : undefined}>about</a>
    {items.map(label => <button class="menu-item" type="button" aria-disabled="true" title="Coming soon">{label}</button>)}
    <button class="contact-button" type="button" aria-label="Contact — coming soon" aria-disabled="true" title="Contact coming soon"><img class="contact-icon-light" src={sitePath('/images/message.svg')} width="24" height="24" alt="" /><img class="contact-icon-dark" src={sitePath('/images/dump/message.svg')} width="24" height="24" alt="" /></button>
  </nav>
  <button class="contact-button contact-button--mobile" type="button" aria-label="Contact — coming soon" aria-disabled="true" title="Contact coming soon"><img src={sitePath('/images/message-mobile.svg')} width="30" height="30" alt="" /></button>
</header>
