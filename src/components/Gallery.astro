---
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';
import type { Project } from '../data/projects';
interface Props { projects: Project[] }
const { projects } = Astro.props;
---
<section class="gallery" aria-label="Selected projects" aria-roledescription="carousel" data-gallery>
  <p class="sr-only" id="gallery-instructions">Drag or scroll vertically or horizontally to explore. Use the arrow keys to navigate and Enter to open the centered project.</p>
  <div class="gallery-viewport" tabindex="0" aria-label="Project gallery" aria-describedby="gallery-instructions" data-viewport>
    <div class="gallery-track" data-track>
      <div class="gallery-group" data-group>{projects.map(project => <ProjectCard project={project} />)}</div>
    </div>
  </div>
</section>
<ProjectDialog projects={projects} />
