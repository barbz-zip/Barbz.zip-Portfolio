---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  draggable?: boolean;
}

const { src, widths, ...attributes } = Astro.props;
// Build-time metadata keeps image dimensions and responsive variants out of client JS.
const images = import.meta.glob<{ default: ImageMetadata }>('../../public/images/**/*.{png,jpg,jpeg,webp}');
const load = images[`../../public${src}`];
if (!load) throw new Error(`Missing portfolio image: ${src}`);
const { default: image } = await load();
const candidates = [...new Set(widths.map(width => Math.min(width, image.width)))].sort((a, b) => a - b);
---
<Image src={image} widths={candidates} width={candidates[candidates.length - 1]} format="webp" quality={90} decoding="async" {...attributes} />
