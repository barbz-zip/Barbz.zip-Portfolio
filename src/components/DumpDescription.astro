---
import { sitePath } from '../lib/paths';
interface Props { images: Array<{ title: string; description: string }>; id?: string }
const { images, id = 'dump-description' } = Astro.props;
---
<aside class="dump-description" data-dump-description data-descriptions={JSON.stringify(images.map(({ title, description }) => ({ title, description })))} aria-label="Image description" aria-hidden="true" inert>
  <button class="pill-button dump-description-toggle" type="button" data-description-toggle aria-expanded="false" aria-controls={`${id}-panel`}>
    Description <img src={sitePath('/images/dump/description-arrow.svg')} alt="" />
  </button>
  <section class="dump-description-panel" id={`${id}-panel`} data-description-panel aria-labelledby={`${id}-title`} aria-hidden="true" inert>
    <button class="dump-description-close" type="button" data-description-close aria-label="Close description">×</button>
    <div data-description-copy aria-live="polite" aria-atomic="true">
      <h2 id={`${id}-title`} data-description-title></h2>
      <p data-description-text></p>
    </div>
  </section>
</aside>
